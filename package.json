{
  "name": "smcp",
  "version": "0.2.0",
  "private": true,
  "description": "Personal app that connects WhatsApp, your machines and Claude.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "smcp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node scripts/run-tests.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "whatsapp:install": "bash scripts/install-wacli.sh",
    "whatsapp:login": "node src/whatsapp-login.js",
    "whatsapp:audio-install": "bash scripts/install-whisper.sh",
    "nightlight:install": "bash scripts/install-nightlight.sh",
    "app": "electron .",
    "icons": "node scripts/make-icons.mjs",
    "dist:mac": "electron-builder --mac --arm64 --publish never -c.directories.output=\"$HOME/Library/Caches/smcp-build\"",
    "dist:win": "electron-builder --win --x64 --publish never -c.directories.output=\"$HOME/Library/Caches/smcp-build\"",
    "dist:linux": "electron-builder --linux --x64 --publish never -c.directories.output=\"$HOME/Library/Caches/smcp-build\"",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "imapflow": "2.11.0",
    "mailparser": "3.14.2",
    "nodemailer": "10.3.1",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "electron": "41.7.1",
    "electron-builder": "26.18.0"
  },
  "author": "Santiago MLR",
  "license": "SEE LICENSE IN LICENSE",
  "repository": "github:santiagomlr/smcp",
  "main": "app/main.js",
  "desktopName": "smcp.desktop",
  "build": {
    "appId": "com.santiago.smcp",
    "productName": "SMCP",
    "asar": false,
    "directories": {
      "buildResources": "app/assets"
    },
    "files": [
      "app/**",
      "src/**",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir",
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "identity": "-",
      "icon": "app/assets/icon.png",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "SMCP usa esto para controlar apps cuando se lo pides y mostrar confirmaciones.",
        "NSScreenCaptureUsageDescription": "SMCP usa esto para tomar capturas de pantalla cuando se lo pides.",
        "NSCalendarsFullAccessUsageDescription": "SMCP muestra tus eventos en el Pronóstico de Tareas.",
        "NSCalendarsUsageDescription": "SMCP muestra tus eventos en el Pronóstico de Tareas.",
        "NSRemindersFullAccessUsageDescription": "SMCP lee y cambia tus recordatorios cuando se lo pides.",
        "NSRemindersUsageDescription": "SMCP lee y cambia tus recordatorios cuando se lo pides.",
        "NSContactsUsageDescription": "SMCP busca en tus contactos cuando le pides datos de una persona."
      },
      "extraResources": [
        {
          "from": "vendor/bin/wacli",
          "to": "bin/wacli"
        },
        {
          "from": "vendor/bin/whisper-cli",
          "to": "bin/whisper-cli"
        },
        {
          "from": "vendor/bin/smcp-nightlight",
          "to": "bin/smcp-nightlight"
        }
      ],
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "SMCP-mac-arm64.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "app/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SMCP-windows-x64-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "app/assets/icon.png",
      "executableName": "smcp",
      "maintainer": "Santiago MLR",
      "synopsis": "Connects your AI to your computer.",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "SMCP-linux-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "SMCP-linux-amd64.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
